   "source": [
    "from math import sqrt\n",
    "def factors(n):\n",
    "    num = n\n",
    "    res = []\n",
    "    for i in range(1,int(sqrt(n))+1):\n",
    "        if num % i == 0:\n",
    "            res.append(i)\n",
    "            if num//i != i:\n",
    "                res.append(num//i)\n",
    "    res.sort()\n",
    "    return res\n",
    "\n",
    "factors(36) "
   ]
  },
