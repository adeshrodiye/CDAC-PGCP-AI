n = int(input("Enter number of games:"))

scores = []

for i in range(n):
    score = int(input(f"Enter score of game {i+1} : "))
    scores.append(score)

scores


min_score = scores[0]
max_score = scores[0]

highest_breaks = 0
lowest_breaks = 0

for score in scores[1:]:
    if score > max_score:
        max_score = score
        highest_breaks += 1
    elif score < min_score:
        min_score = score
        lowest_breaks += 1

output = [highest_breaks,lowest_breaks]
output





