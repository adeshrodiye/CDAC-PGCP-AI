   "source": [
    "len = 3\n",
    "\n",
    "name = 'Ritcha'\n",
    "age = 30\n",
    "\n",
    "def display_details():\n",
    "    name = 'Riya'\n",
    "    age = 23\n",
    "    print(f'{name} -- {age}')\n",
    "\n",
    "if __name__ == '__main__':\n",
    "    print(f'{name} -- {age}')\n",
    "    display_details()"
