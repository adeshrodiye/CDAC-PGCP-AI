sns.heatmap(df20.isna(),cmap=["#e2e8f0", "#e11d48"],cbar=False,linewidths=1.5,linecolor="white",yticklabels=True)
plt.title("Distribution of Missing Values (Yellow indicates missing value)")
plt.show()









