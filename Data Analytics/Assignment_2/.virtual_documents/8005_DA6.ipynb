    print(f"NaN found at Row Index {idx}, Column '{df18.columns[col_idx]}'")





df19 = df13.copy()

for col in df19.columns:
    mode_val = df19[col].mode()
    if not mode_val.empty:
        df19[col] = df19[col].fillna(mode_val[0])
display(df19)





import seaborn as sns
import matplotlib.pyplot as plt

df20 = df13.copy()
