





import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import pandas as pd


df = pd.read_csv("alphabet_stock_data.csv")
df.head()





df['Date'] = pd.to_datetime(df['Date'])
df.set_index('Date', inplace=True)

start_date = '2020-04-01'
end_date = '2020-04-30'
df_filtered = df.loc[start_date:end_date]


plt.figure(figsize=(10, 4))
df_filtered['Close'].plot(kind='line', title='Alphabet Inc. Historical Stock Prices (Close)')
plt.ylabel('Price')
plt.show()





plt.figure(figsize=(10, 4))
df_filtered[['Open', 'Close']].plot(kind='line', title='Alphabet Inc. Opening & Closing Prices')
plt.ylabel('Price')
plt.show()





plt.figure(figsize=(10, 4))
df_filtered['Volume'].plot(kind='bar', title='Alphabet Inc. Trading Volume')
plt.ylabel('Volume')
plt.show()





plt.figure(figsize=(10, 4))
df_filtered[['Open', 'Close']].plot(kind='bar', title='Alphabet Inc. Opening & Closing Prices')
plt.ylabel('Price')
plt.show()





plt.figure(figsize=(10, 4))
df_filtered[['Open', 'Close']].plot(kind='bar', stacked=True, title='Alphabet Inc. Stacked Opening & Closing Prices')
plt.ylabel('Price')
plt.show()





plt.figure(figsize=(10, 6))
df_filtered[['Open', 'Close']].plot(kind='barh', stacked=True, title='Alphabet Inc. Horizontal Stacked Opening & Closing Prices')
plt.xlabel('Price')
plt.show()





plt.figure(figsize=(10, 6))
df_filtered[['Open', 'Close', 'High', 'Low']].plot(kind='hist', alpha=0.5, title='Histograms of Opening, Closing, High, Low Stock Prices')
plt.xlabel('Price')
plt.show()





plt.figure(figsize=(10, 6))
df_filtered[['Open', 'Close', 'High', 'Low']].plot(kind='hist', stacked=True, alpha=0.5, title='Stacked Histograms of Prices')
plt.xlabel('Price')
plt.show()





plt.figure(figsize=(10, 4))
df_filtered['Open'].plot(kind='hist', orientation='horizontal', cumulative=True, title='Horizontal and Cumulative Histogram of Opening Prices')
plt.xlabel('Frequency / Cumulative')
plt.show()





plt.figure(figsize=(10, 6))
df_filtered[['Open', 'Close', 'High', 'Low']].plot(kind='hist', stacked=True, bins=25, alpha=0.5, title='Stacked Histograms (25 Bins) of Prices')
plt.xlabel('Price')
plt.show()





plt.figure(figsize=(10, 6))
df_filtered[['Open', 'Close', 'High', 'Low']].plot(kind='hist', stacked=True, bins=40, alpha=0.5, title='Stacked Histograms (40 Bins) of Prices')
plt.xlabel('Price')
plt.show()





fig, ax1 = plt.subplots(figsize=(12, 6))
ax1.plot(df_filtered.index, df_filtered['Close'], color='blue', label='Close')
ax1.set_ylabel('Stock Price', color='blue')
ax1.tick_params(axis='y', labelcolor='blue')
ax2 = ax1.twinx()
ax2.bar(df_filtered.index, df_filtered['Volume'], alpha=0.3, color='orange', label='Volume', width=0.6)
ax2.set_ylabel('Volume', color='orange')
ax2.tick_params(axis='y', labelcolor='orange')
plt.title('Stock Price & Trading Volume')
plt.show()





fig, ax1 = plt.subplots(figsize=(12, 6))
df_filtered[['Open', 'High', 'Low', 'Close', 'Adj Close']].plot(ax=ax1)
ax1.set_ylabel('Price')

ax2 = ax1.twinx()
df_filtered['Volume'].plot(kind='area', ax=ax2, alpha=0.1, color='purple', label='Volume')
ax2.set_ylabel('Volume')
plt.title('All Price Indicators & Volume')
plt.show()






df['SMA30'] = df['Adj Close'].rolling(window=30).mean()
df['SMA40'] = df['Adj Close'].rolling(window=40).mean()
df.loc[start_date:end_date][['Adj Close', 'SMA30', 'SMA40']].plot(figsize=(10, 5), title='Adj Close, SMA 30 & SMA 40')
plt.ylabel('Price')
plt.show()





df['EMA30'] = df['Adj Close'].ewm(span=30, adjust=False).mean()
df.loc[start_date:end_date][['Adj Close', 'SMA30', 'EMA30']].plot(figsize=(10, 5), title='Adj Close, SMA 30 & EMA 30')
plt.ylabel('Price')
plt.show()





plt.figure(figsize=(10, 5))
plt.scatter(df_filtered['Volume'], df_filtered['Close'], alpha=0.7, color='green')
plt.title('Volume vs Stock Price')
plt.xlabel('Volume')
plt.ylabel('Close Price')
plt.show()





df['Daily Return'] = df['Close'].pct_change() * 100
df.loc[start_date:end_date]['Daily Return'].plot(figsize=(10, 4), marker='o', color='purple', title='Daily Percentage Returns')
plt.ylabel('Percentage %')
plt.show()





df['Volatility'] = df['Daily Return'].rolling(window=7).std()
df.loc[start_date:end_date]['Volatility'].plot(figsize=(10, 4), color='red', title='7-Day Rolling Volatility')
plt.ylabel('Volatility')
plt.show()





df.loc[start_date:end_date]['Daily Return'].plot(kind='hist', bins=15, color='teal', edgecolor='black', title='Daily Return Distribution')
plt.xlabel('Daily Return (%)')
plt.show()



